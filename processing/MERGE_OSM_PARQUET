from pathlib import Path
import geopandas as gpd
import pandas as pd

# 分块 Parquet 所在文件夹
WORK_DIR = Path(r"\CITY")

# 原始研究范围面：米制 CRS 的 GeoPackage
FINAL_AOI_FILE = WORK_DIR / "CITY_aoi_projected.gpkg"

# 最终输出：一个 GeoPackage
OUT_FILE = WORK_DIR / "CITY_osm_roads_2025-12-31.gpkg"

# 找到先前已下载的分块文件
parts = sorted(WORK_DIR.glob("_part_*.parquet"))
print("找到的分块文件：", len(parts))
for p in parts:
    print(" ", p.name, f"{p.stat().st_size:,} bytes")

if not parts:
    raise FileNotFoundError(
        f"在 {WORK_DIR} 中没找到 _part_*.parquet。"
        "请检查下载脚本里临时分块的保存位置。"
    )

if not FINAL_AOI_FILE.exists():
    raise FileNotFoundError(f"找不到 AOI：{FINAL_AOI_FILE}")

# 读取每个分块并统一活动几何列名
frames = [gpd.read_parquet(p) for p in parts]

for frame in frames:
    geom_name = frame.geometry.name
    if geom_name != "geometry":
        frame.rename_geometry("geometry", inplace=True)

# 合并为一个 GeoDataFrame
data = gpd.GeoDataFrame(
    pd.concat(frames, ignore_index=True),
    geometry="geometry",
    crs=frames[0].crs,
)

print("合并后记录数（去重前）：", len(data))

# 同一个 OSM 要素可能出现在相邻分块，按 OSM 类型和 ID 去重
data = data.drop_duplicates(subset=["osm_type", "osm_id"])
print("按 osm_type + osm_id 去重后：", len(data))

# 用原始研究范围做最终裁切
aoi = gpd.read_file(FINAL_AOI_FILE)
if aoi.crs is None:
    raise ValueError("AOI 文件没有 CRS。")
if data.crs is None:
    raise ValueError("下载的道路数据没有 CRS。")

data = data.to_crs(aoi.crs)
clip_geom = aoi.geometry.union_all()
data = gpd.clip(data, clip_geom)
data = data[data.geometry.notna() & ~data.geometry.is_empty]

print("按原始 AOI 裁切后：", len(data))

if data.empty:
    raise RuntimeError(
        "裁切结果为空。临时分块保留着；请不要删除，检查 AOI 和数据 CRS。"
    )

if OUT_FILE.exists():
    raise FileExistsError(
        f"输出文件已存在，为避免覆盖先停止：{OUT_FILE}\n"
        "如需另存，请修改 OUT_FILE 文件名。"
    )

# 写出单个空间数据文件
data.to_file(
    OUT_FILE,
    layer="osm_roads_2025",
    driver="GPKG",
)

print("成功保存：", OUT_FILE)
print("最终要素数：", len(data))
print("临时分块保留未删；确认输出正常后再手动删除。")
